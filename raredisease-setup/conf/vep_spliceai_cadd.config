/*
 * Full annotation WITH SpliceAI (masked precomputed scores from CADD v1.7 annotations): first_pass.config plus dbNSFP 4.9a (REVEL, GERP++, phastCons, phyloP)
 * and the REVEL and SpliceAI plugins for genome SNVs. MT args unchanged (no SpliceAI there).
 * Use with vep_plugin_files: <REF>/vep_files_spliceai_cadd.csv.
 *
 *   -c conf/local.config -c conf/vep_spliceai_cadd.config
 * (Nextflow 26 strict config syntax: no variables here, so the option list is repeated.)
 */

process {
    withName: '.*ANNOTATE_GENOME_SNVS:ENSEMBLVEP_SNV' {
        ext.args = { [
            '--dir_plugins vep_cache/Plugins',
            '--plugin LoFtool,LoFtool_scores.txt',
            '--plugin pLI,pLI_values.txt',
            '--plugin SpliceAI,snv=spliceai_masked_cadd_grch38.vcf.gz,indel=spliceai_masked_cadd_grch38.vcf.gz',
            '--plugin dbNSFP,dbNSFP4.9a_grch38.gz,REVEL_score,REVEL_rankscore,GERP++_RS,phastCons100way_vertebrate,phyloP100way_vertebrate',
            '--plugin REVEL,file=revel_grch38.tsv.gz',
            '--custom clinvar_chr.vcf.gz,CLINVAR,vcf,exact,0,CLNSIG,CLNREVSTAT,CLNDN',
            '--distance 5000',
            '--buffer_size 20000',
            '--format vcf --max_sv_size 248956422',
            '--appris --biotype --cache --canonical --ccds --compress_output bgzip',
            '--domains --exclude_predicted --force_overwrite',
            '--hgvs --humdiv --no_progress --numbers',
            '--merged --polyphen p --protein --offline --regulatory --sift p --symbol --tsl',
            '--uniprot --vcf'
        ].join(' ') }
    }
    withName: '.*ANNOTATE_MT_SNVS:ENSEMBLVEP_MT' {
        ext.args = { [
            '--dir_plugins vep_cache/Plugins',
            '--plugin LoFtool,LoFtool_scores.txt',
            '--plugin pLI,pLI_values.txt',
            '--custom clinvar_chr.vcf.gz,CLINVAR,vcf,exact,0,CLNSIG,CLNREVSTAT,CLNDN',
            '--distance 0',
            '--buffer_size 20000',
            '--format vcf --max_sv_size 248956422',
            '--appris --biotype --cache --canonical --ccds --compress_output bgzip',
            '--domains --exclude_predicted --force_overwrite',
            '--hgvs --humdiv --no_progress --numbers',
            '--merged --polyphen p --protein --offline --regulatory --sift p --symbol --tsl --vcf',
            '--uniprot'
        ].join(' ') }
    }
}
