/*
 * First pass while CADD and SpliceAI are not available yet.
 * Same VEP options as the pipeline, minus the SpliceAI plugin, plus ClinVar (--custom) for the rank model.
 * Use with params_first_pass overrides (see windows/run_sample_first_pass.sh): vep_plugin_files -> vep_files_first_pass.csv,
 * vcfanno_resources/vcfanno_toml -> *_nocadd, and no cadd_resources.
 * Later rerun with the normal config and params plus -resume: alignment and calling stay cached,
 * only annotation and ranking run again.
 *
 *   -c conf/local.config -c conf/first_pass.config
 * (Nextflow 26 strict config syntax: no variables here, so the option list is repeated.)
 */

process {
    withName: '.*ANNOTATE_GENOME_SNVS:ENSEMBLVEP_SNV' {
        ext.args = { [
            '--dir_plugins vep_cache/Plugins',
            '--plugin LoFtool,LoFtool_scores.txt',
            '--plugin pLI,pLI_values.txt',
            '--custom clinvar_chr.vcf.gz,CLINVAR,vcf,exact,0,CLNSIG,CLNREVSTAT,CLNDN',
            '--distance 5000',
            '--buffer_size 20000',
            '--format vcf --max_sv_size 248956422',
            '--appris --biotype --cache --canonical --ccds --compress_output bgzip',
            '--domains --exclude_predicted --force_overwrite',
            '--hgvs --humdiv --no_progress --numbers',
            '--merged --polyphen p --protein --offline --regulatory --sift p --symbol --tsl',
            '--uniprot --vcf'
        ].join(' ') }
    }
    withName: '.*ANNOTATE_MT_SNVS:ENSEMBLVEP_MT' {
        ext.args = { [
            '--dir_plugins vep_cache/Plugins',
            '--plugin LoFtool,LoFtool_scores.txt',
            '--plugin pLI,pLI_values.txt',
            '--custom clinvar_chr.vcf.gz,CLINVAR,vcf,exact,0,CLNSIG,CLNREVSTAT,CLNDN',
            '--distance 0',
            '--buffer_size 20000',
            '--format vcf --max_sv_size 248956422',
            '--appris --biotype --cache --canonical --ccds --compress_output bgzip',
            '--domains --exclude_predicted --force_overwrite',
            '--hgvs --humdiv --no_progress --numbers',
            '--merged --polyphen p --protein --offline --regulatory --sift p --symbol --tsl --vcf',
            '--uniprot'
        ].join(' ') }
    }
}
