/*
 * Local workstation config for nf-core/raredisease 3.1.2 (WGS, GRCh38, Docker).
 * Use with:  -c conf/local.config
 * Only infrastructure settings go here; all pipeline parameters live in params_grch38_wgs.yaml
 * (the pipeline docs warn against putting params in a -c config).
 *
 * EDIT the three numbers below to match your machine (check with `nproc` and `free -g`).
 * Leave ~2 cores and ~8 GB RAM for the OS and Nextflow itself.
 *
 * This machine: AMD Ryzen 9 9950X (16 cores / 32 threads), 125.6 GB RAM, Windows 11 + WSL2.
 * %UserProfile%\.wslconfig gives the WSL2 VM processors=32 and memory=116GB, so the limits below
 * leave 2 threads and ~6 GB inside WSL for Nextflow, Docker and the OS. RAM is above ~96 GB, so
 * aligner "bwamem2" stays (its GRCh38 index build needs ~90 GB).
 */

process {
    executor       = 'local'
    resourceLimits = [
        cpus  : 30,          // 32 threads in WSL -> 30
        memory: 100.GB,      // 116 GB given to WSL (113 visible) -> 100.GB headroom
        time  : 72.h
    ]

    // Retry once with more resources on out-of-memory / killed exits, then give up
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) && task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries    = 2

    // Keep the per-sample DeepVariant gVCFs. The pipeline only publishes the joint (GLnexus) case VCF,
    // but the in-house Yakut allele-frequency database is built from gVCFs (scripts/build_yakut_af.sh).
    // Not yet tested: after the first run, check that results/deepvariant_gvcf/ exists. If it does not,
    // the gVCFs are still in work/ (find work -name '*_deepvar.g.vcf.gz') until you clean it.
    // genmod models on a WGS case (~3 M SNVs, --whole_gene) needed >34 GB: at the default 36 GB it was
    // OOM-killed and the task then hung for hours with no error (dead multiprocessing manager).
    // It runs near the end, when little else is running, so give it most of the machine.
    // genmod compound was OOM-killed at 36 GB too (00:29 on the same case), so cover every genmod step.
    withName: '.*RANK_VARIANTS_SNV:GENMOD_.*' {
        memory = 100.GB
        time   = 24.h
    }

    // TIDDIT_SV (process_medium: 6 CPU / 36 GB / 8 h) hit the 8 h limit on SAMPLE01 (111 GB FASTQ, 41x, 2026-10-24),
    // stuck for 7.5 h at load 1. It peaked at 30.6 GB on SAMPLE03 (36x); docker lets a container swap up to 2x its
    // memory instead of OOM-killing it, so going over the limit means crawling on swap.
    // The hang is TIDDIT's local assembly of the chr5 pericentromeric satellite (~13 k clipped reads in one 100 kb
    // window at 49.6 Mb): single-threaded, 25 GB, >7.5 h in both runs. --skip_assembly drops that step (Manta and
    // CNVnator still go into the SVDB merge); without it TIDDIT itself stays under 1 GB. The module adds --threads.
    withName: '.*:TIDDIT_SV' {
        ext.args = '-p 6 --skip_assembly'
        time     = 48.h
        memory   = 16.GB
    }

    // GLNEXUS and BWAMEM2_MEM_MT are process_high (12 CPU / 72 GB); 72 GB never fit next to TIDDIT under the 100 GB
    // limit, so they sat in the queue. Single-sample GLnexus and chrM-only alignment need far less.
    withName: '.*CALL_SNV_DEEPVARIANT:GLNEXUS' {
        cpus   = 12
        memory = 32.GB
    }
    withName: '.*ALIGN_MT.*:BWAMEM2_MEM_MT' {
        cpus   = 8
        memory = 16.GB
    }

    // Genome alignment is process_high (12 CPU / 72 GB): on SAMPLE01 the 6 lanes ran one at a time (3 h 48 min)
    // although each used ~29 GB. 2 x 14 CPU / 40 GB fit side by side. The module passes task.cpus to bwa-mem2 -t
    // and samtools sort -@; SAMTOOLS_MERGE (process_low, 2 CPU, 1 h 02 min) uses --threads task.cpus-1.
    withName: '.*ALIGN:ALIGN_BWA_BWAMEM2_BWAMEME:BWAMEM2_MEM' {
        cpus   = 14
        memory = 40.GB
    }
    withName: '.*ALIGN:ALIGN_BWA_BWAMEM2_BWAMEME:SAMTOOLS_MERGE' {
        cpus   = 8
    }
    // FASTP is process_medium (6 CPU / 36 GB) but used 1.6 GB on SAMPLE02, so the 6 lanes ran one at a time.
    withName: '.*ALIGN:FASTP' {
        memory = 4.GB
    }

    // Mobile-element calling (24 + 24 short 2-CPU tasks) starts together with DeepVariant after MARKDUPLICATES and
    // kept 24 CPUs from ever being free at once: DeepVariant waited 56 min on SAMPLE02. It is off the critical path.
    // maxForks counts per process: 1 + 1 leaves ME at <= 4 CPU, so with TIDDIT_SV/QC done DeepVariant's 24 fit in 30
    // (4 + 4 would still be 16 CPU and block it). The ~48 tasks then take ~4 h, alongside DeepVariant and CADD.
    withName: '.*CALL_MOBILE_ELEMENTS:ME_SPLIT_ALIGNMENT|.*CALL_MOBILE_ELEMENTS:RETROSEQ_DISCOVER' {
        maxForks = 1
    }

    // SNV/SV annotation steps are process_medium (6 CPU / 36 GB): only two fit under 100 GB, so on SAMPLE01 CADD
    // ran 2 at a time with the CPU 93% idle. Real use there: CADD ~1.5 cores, 13-15 GB per chunk (first chunk 29 GB),
    // the bcftools/tabix helpers a few MB for seconds. The CADD selector must stay after the ANNOTATE_CADD.* one.
    withName: '.*:ANNOTATE_CADD.*' {
        memory = 2.GB
    }
    withName: '.*:ANNOTATE_CADD:CADD' {
        memory = 24.GB
    }
    withName: '.*ANNOTATE_GENOME_SNVS:BCFTOOLS_VIEW' {
        memory = 2.GB
    }
    withName: '.*ANNOTATE_GENOME_SNVS:ENSEMBLVEP_SNV' {
        memory = 16.GB
    }
    withName: '.*ANNOTATE_STRUCTURAL_VARIANTS:SVDB_QUERY_DB' {
        memory = 8.GB
    }

    withName: '.*CALL_SNV_DEEPVARIANT:DEEPVARIANT' {
        // process_high gives 12 CPU / 72 GB; real use on SAMPLE01 was ~12 cores, ~14 GB. 24 CPU + TIDDIT's 6 = 30.
        cpus       = 24
        memory     = 56.GB
        time       = 72.h
        publishDir = [
            path   : { "${params.outdir}/deepvariant_gvcf" },
            mode   : 'copy',
            pattern: '*.g.vcf.gz*',
            enabled: true
        ]
    }
}

executor {
    name      = 'local'
    cpus      = 30          // keep equal to resourceLimits.cpus
    memory    = '100 GB'    // keep equal to resourceLimits.memory
}

docker {
    enabled    = true
    // Run containers as your own user so result files are not owned by root
    runOptions = '-u $(id -u):$(id -g)'
}

// No env.TMPDIR here: it is passed into every container, where /data/raredisease/tmp is not mounted,
// and DeepVariant (GNU parallel) then fails with "Tmpdir does not exist". Under WSL2 /tmp and the
// work/ dir are on the same virtual disk anyway, so tools writing to the task work dir is fine.

// Keep reports for every run
timeline { enabled = true }
report   { enabled = true }
trace    { enabled = true }
