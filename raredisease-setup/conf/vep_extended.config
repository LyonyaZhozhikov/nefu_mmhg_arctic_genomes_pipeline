/*
 * Optional: richer VEP annotation for genome SNVs so the rank model can use ClinVar,
 * REVEL and conservation scores. nf-core/raredisease 3.1.2 by default only runs the
 * LoFtool, pLI and SpliceAI plugins, so those rank-model sections are otherwise "not_reported".
 *
 * Use together with local.config:  -c conf/local.config -c conf/vep_extended.config
 *
 * Also set  vep_plugin_files: <REF>/vep_files_extended.csv  in the params file so these files get staged.
 * Requirements:
 *   - vep_cache/Plugins/ contains LoFtool.pm, pLI.pm, SpliceAI.pm, dbNSFP.pm (VEP_plugins release/110)
 *   - clinvar_chr.vcf.gz (+.tbi): NCBI ClinVar GRCh38 VCF with contigs renamed 1 -> chr1
 *   - dbNSFP4.9a_grch38.gz (+.tbi): built per the dbNSFP.pm header instructions.
 *     Check the column names with:  zcat dbNSFP4.9a_grch38.gz | head -1 | tr '\t' '\n' | grep -n -e REVEL -e GERP -e 100way
 *     dbNSFP is free for academic use only.
 */

process {
    withName: '.*ANNOTATE_GENOME_SNVS:ENSEMBLVEP_SNV' {
        ext.args = { [
            '--dir_plugins vep_cache/Plugins',
            '--plugin LoFtool,LoFtool_scores.txt',
            '--plugin pLI,pLI_values.txt',
            '--plugin SpliceAI,snv=spliceai_21_scores_raw_snv_-v1.3-.vcf.gz,indel=spliceai_21_scores_raw_snv_-v1.3-.vcf.gz',
            '--plugin dbNSFP,dbNSFP4.9a_grch38.gz,REVEL_score,GERP++_RS,phastCons100way_vertebrate,phyloP100way_vertebrate',
            '--custom clinvar_chr.vcf.gz,CLINVAR,vcf,exact,0,CLNSIG,CLNREVSTAT,CLNDN',
            '--distance 5000',
            '--buffer_size 20000',
            '--format vcf --max_sv_size 248956422',
            '--appris --biotype --cache --canonical --ccds --compress_output bgzip',
            '--domains --exclude_predicted --force_overwrite',
            '--hgvs --humdiv --no_progress --numbers',
            '--merged --polyphen p --protein --offline --regulatory --sift p --symbol --tsl',
            '--uniprot --vcf'
        ].join(' ') }
    }
}
